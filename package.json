{
  "name": "tinyrack-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "biome": "biome check .",
    "ci:plan:test": "node --test scripts/ci-change-plan.test.ts",
    "scripts:check": "tsc -p tsconfig.scripts.json",
    "tokens:generate": "node scripts/generate-design-tokens.ts",
    "tokens:check": "node scripts/generate-design-tokens.ts --check",
    "flutter:analyze": "cd packages/tinyrack_ui && flutter analyze",
    "flutter:test": "cd packages/tinyrack_ui && flutter test",
    "flutter:preview:build": "node scripts/build-flutter-preview.ts",
    "flutter:preview:budget": "node scripts/check-flutter-preview-budget.ts",
    "flutter:preview:generate": "node scripts/generate-flutter-preview-registry.ts",
    "flutter:preview:check": "node scripts/generate-flutter-preview-registry.ts --check",
    "test": "pnpm build && node scripts/run-prepared-tests.ts",
    "dev": "node scripts/dev-with-flutter.ts",
    "build": "pnpm scripts:check && pnpm --filter @tinyrack/ui build && pnpm --filter @tinyrack/docs build && pnpm flutter:preview:build && pnpm --filter @tinyrack/homepage build && pnpm flutter:preview:budget",
    "docs:build": "pnpm build",
    "docs:preview": "pnpm docs:build && pnpm --filter @tinyrack/homepage preview",
    "docs:deploy": "pnpm --filter @tinyrack/homepage run deploy",
    "docs:deploy:dry-run": "pnpm --filter @tinyrack/homepage deploy:dry-run",
    "pack:ui": "pnpm --config.ignore-scripts=true --dir packages/ui pack --dry-run",
    "pack:docs": "pnpm --config.ignore-scripts=true --dir packages/docs pack --dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs,css,json}": "node node_modules/@biomejs/biome/bin/biome check --write --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "24.13.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "7.0.2"
  }
}
