{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.tinyrack.net/design-tokens/schema.json",
  "title": "Tinyrack cross-platform design tokens",
  "type": "object",
  "required": [
    "version",
    "borders",
    "breakpoints",
    "controlMetrics",
    "layers",
    "measurements",
    "motion",
    "opacity",
    "palettes",
    "radii",
    "semanticColors",
    "shadows",
    "spacing",
    "spinnerMetrics",
    "typography"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 }
  },
  "additionalProperties": {
    "type": "object"
  }
}
