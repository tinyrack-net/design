{
  "name": "@tinyrack/homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-worktree.ts",
    "dev:app": "cross-env NODE_OPTIONS=--conditions=@tinyrack/source react-router dev",
    "build": "node scripts/build.ts",
    "preview": "vite preview",
    "typegen": "react-router typegen",
    "sync:brand": "node scripts/sync-brand.ts",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:ci-fast": "pnpm test:unit && vitest run --project e2e-smoke",
    "test:ci-full": "pnpm test:prepared",
    "test:prepared": "pnpm test:unit && vitest run --project e2e && vitest run --project e2e-overlays",
    "test:parity": "vitest run --project e2e-parity",
    "test:unit": "vitest run --project unit",
    "test:e2e": "pnpm build && vitest run --project e2e && vitest run --project e2e-overlays",
    "test:flutter-dev": "vitest run --project e2e-flutter-dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@tinyrack/docs": "workspace:*",
    "@tinyrack/ui": "workspace:*",
    "isbot": "5.2.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@mdx-js/rollup": "3.1.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "10.1.0",
    "playwright": "1.63.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
