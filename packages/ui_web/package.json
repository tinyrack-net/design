{
  "name": "@tinyrack/ui",
  "version": "0.23.0",
  "description": "React-only Tinyrack UI components and design tokens.",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "theme",
    "tokens",
    "typescript",
    "ui"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "author": "Tinyrack",
  "homepage": "https://www.npmjs.com/package/@tinyrack/ui",
  "bugs": {
    "url": "https://github.com/tinyrack-net/design/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyrack-net/design.git",
    "directory": "packages/ui_web"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-design-tokens.ts --check --web-only && node scripts/generate-brand-rasters.ts --check && tsdown",
    "generate:brand-rasters": "node scripts/generate-brand-rasters.ts",
    "generate:wordmark": "node --experimental-strip-types scripts/generate-wordmark.ts",
    "test": "pnpm test:unit && pnpm test:docs-contract && pnpm test:e2e",
    "test:prepared": "pnpm test:unit && pnpm test:docs-contract && pnpm test:chromium && pnpm test:firefox",
    "test:docs-contract": "vitest run --project docs-contract",
    "test:unit": "vitest run --project unit",
    "test:e2e": "pnpm build && pnpm test:chromium && pnpm test:firefox",
    "test:chromium": "vitest run --mode component-coverage --project browser --coverage",
    "test:firefox": "vitest run --mode component-firefox --project browser",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "shiki": ">=4.0.0 <5.0.0",
    "tailwindcss": ">=4.3.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "opentype.js": "^2.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.3",
    "shiki": "4.4.2",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./brand/*": {
      "@tinyrack/source": "./src/brand/*",
      "default": "./dist/brand/*"
    },
    "./components/*": {
      "@tinyrack/source": "./src/components/*/index.tsx",
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./components/*.css": {
      "@tinyrack/source": "./src/components/*/*.css",
      "default": "./dist/components/*/*.css"
    },
    "./components/*/react": null,
    "./components/*/dom": null,
    "./components/overlay": null,
    "./providers/*": {
      "@tinyrack/source": "./src/providers/*/index.tsx",
      "types": "./dist/providers/*/index.d.ts",
      "import": "./dist/providers/*/index.js"
    },
    "./highlighters/*": {
      "@tinyrack/source": "./src/highlighters/*/index.ts",
      "types": "./dist/highlighters/*/index.d.ts",
      "import": "./dist/highlighters/*/index.js"
    },
    "./core": {
      "@tinyrack/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core.css": {
      "@tinyrack/source": "./src/core/core.css",
      "default": "./dist/core.css"
    },
    "./mdx": {
      "@tinyrack/source": "./src/mdx/index.tsx",
      "types": "./dist/mdx/index.d.ts",
      "import": "./dist/mdx/index.js"
    },
    "./mdx.css": {
      "@tinyrack/source": "./src/mdx/mdx.css",
      "default": "./dist/mdx.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./brand/*": "./dist/brand/*",
      "./components/*": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/components/*/index.js"
      },
      "./components/*.css": "./dist/components/*/*.css",
      "./components/*/react": null,
      "./components/*/dom": null,
      "./components/overlay": null,
      "./providers/*": {
        "types": "./dist/providers/*/index.d.ts",
        "import": "./dist/providers/*/index.js"
      },
      "./highlighters/*": {
        "types": "./dist/highlighters/*/index.d.ts",
        "import": "./dist/highlighters/*/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js"
      },
      "./core.css": "./dist/core.css",
      "./mdx": {
        "types": "./dist/mdx/index.d.ts",
        "import": "./dist/mdx/index.js"
      },
      "./mdx.css": "./dist/mdx.css",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "lucide-react": "1.28.0"
  }
}
