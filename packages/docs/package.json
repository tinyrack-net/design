{
  "name": "@tinyrack/docs",
  "version": "0.22.0",
  "description": "React Router documentation framework for Tinyrack projects.",
  "keywords": [
    "documentation",
    "mdx",
    "react",
    "react-router",
    "ssg",
    "tinyrack"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "author": "Tinyrack",
  "homepage": "https://www.npmjs.com/package/@tinyrack/docs",
  "bugs": {
    "url": "https://github.com/tinyrack-net/design/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyrack-net/design.git",
    "directory": "packages/docs"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:prepared": "pnpm test:unit && vitest run --project e2e",
    "test:unit": "tsc -p tsconfig.test.json --noEmit && vitest run --project unit",
    "test:e2e": "pnpm build && vitest run --project e2e",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@tailwindcss/vite": ">=4.3.0 <5.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": ">=8.2.0 <9.0.0",
    "tailwindcss": ">=4.3.0 <5.0.0",
    "vite": ">=8.0.0 <9.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@react-router/dev": "8.3.0",
    "@shikijs/langs": "4.4.2",
    "@shikijs/themes": "4.4.2",
    "@tinyrack/ui": "workspace:^",
    "lucide-react": "1.28.0",
    "pagefind": "1.5.2",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.3",
    "shiki": "4.4.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./config": {
      "@tinyrack/source": "./src/entrypoints/config.ts",
      "types": "./dist/entrypoints/config.d.ts",
      "import": "./dist/entrypoints/config.js"
    },
    "./react-router": {
      "@tinyrack/source": "./src/entrypoints/react-router.ts",
      "types": "./dist/entrypoints/react-router.d.ts",
      "import": "./dist/entrypoints/react-router.js"
    },
    "./runtime": {
      "@tinyrack/source": "./src/entrypoints/runtime.ts",
      "types": "./dist/entrypoints/runtime.d.ts",
      "import": "./dist/entrypoints/runtime.js"
    },
    "./site": {
      "@tinyrack/source": "./src/entrypoints/site.ts",
      "types": "./dist/entrypoints/site.d.ts",
      "import": "./dist/entrypoints/site.js"
    },
    "./vite": {
      "@tinyrack/source": "./src/entrypoints/vite.ts",
      "types": "./dist/entrypoints/vite.d.ts",
      "import": "./dist/entrypoints/vite.js"
    },
    "./styles.css": {
      "@tinyrack/source": "./src/styles/styles.css",
      "default": "./dist/styles/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./config": {
        "types": "./dist/entrypoints/config.d.ts",
        "import": "./dist/entrypoints/config.js"
      },
      "./react-router": {
        "types": "./dist/entrypoints/react-router.d.ts",
        "import": "./dist/entrypoints/react-router.js"
      },
      "./runtime": {
        "types": "./dist/entrypoints/runtime.d.ts",
        "import": "./dist/entrypoints/runtime.js"
      },
      "./site": {
        "types": "./dist/entrypoints/site.d.ts",
        "import": "./dist/entrypoints/site.js"
      },
      "./vite": {
        "types": "./dist/entrypoints/vite.d.ts",
        "import": "./dist/entrypoints/vite.js"
      },
      "./styles.css": "./dist/styles/styles.css",
      "./package.json": "./package.json"
    }
  }
}
